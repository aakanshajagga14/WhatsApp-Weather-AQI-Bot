import requests
import pywhatkit
from datetime import datetime


# ================= CONFIG =================
# 1) Put your API keys here
OPENWEATHER_API_KEY = "YOUR_OPENWEATHER_KEY"   # from https://openweathermap.org/api
WAQI_TOKEN = "YOUR_WAQI_TOKEN"                # from https://aqicn.org/data-platform/token/#/
# =========================================


def get_weather(city: str):
    """
    Fetch current weather for a city from OpenWeather (in Celsius).
    """
    base_url = "https://api.openweathermap.org/data/2.5/weather"
    params = {
        "q": city,
        "appid": OPENWEATHER_API_KEY,
        "units": "metric",  # Celsius
    }

    response = requests.get(base_url, params=params)
    data = response.json()

    if response.status_code != 200 or data.get("cod") != 200:
        raise ValueError(f"Weather API error: {data.get('message', 'Unknown error')}")

    main = data["main"]
    weather_desc = data["weather"][0]["description"]
    temp = main["temp"]
    feels_like = main["feels_like"]
    humidity = main["humidity"]

    return {
        "temp": temp,
        "feels_like": feels_like,
        "description": weather_desc,
        "humidity": humidity,
    }


def get_aqi(city: str):
    """
    Fetch AQI for a city from WAQI (World Air Quality Index).
    """
    base_url = f"https://api.waqi.info/feed/{city}/"
    params = {
        "token": WAQI_TOKEN
    }

    response = requests.get(base_url, params=params)
    data = response.json()

    if data.get("status") != "ok":
        raise ValueError(f"AQI API error: {data.get('data', 'Unknown error')}")

    aqi = data["data"]["aqi"]
    return aqi


def aqi_category(aqi: int) -> str:
    """
    Convert numeric AQI to a simple category.
    """
    if aqi <= 50:
        return "Good"
    elif aqi <= 100:
        return "Satisfactory"
    elif aqi <= 200:
        return "Moderate"
    elif aqi <= 300:
        return "Poor"
    elif aqi <= 400:
        return "Very Poor"
    else:
        return "Severe"


def build_message(city: str) -> str:
    """
    Build the WhatsApp message text with weather and AQI.
    """
    weather = get_weather(city)
    aqi = get_aqi(city)
    aqi_cat = aqi_category(aqi)

    msg = (
        f"Weather & AQI Update for {city}:\n"
        f"- Temperature: {weather['temp']}°C (feels like {weather['feels_like']}°C)\n"
        f"- Conditions: {weather['description']}\n"
        f"- Humidity: {weather['humidity']}%\n"
        f"- AQI: {aqi} ({aqi_cat})\n"
    )

    return msg


def send_whatsapp_scheduled(phone_no: str, message: str, hour: int, minute: int):
    """
    Schedule a WhatsApp message using pywhatkit.sendwhatmsg.
    Phone number must be like '+911234567890'.
    """
    pywhatkit.sendwhatmsg(phone_no, message, hour, minute)


def send_whatsapp_instant(phone_no: str, message: str):
    """
    Send a WhatsApp message instantly (opens web.whatsapp and sends).
    """
    # wait_time and tab_close options can be tuned if needed
    pywhatkit.sendwhatmsg_instantly(phone_no, message, wait_time=15, tab_close=True, close_time=5)


if __name__ == "__main__":
    # ======= USER INPUTS =======
    city = input("Enter city name (e.g. Delhi): ").strip()
    phone = input("Enter WhatsApp number with country code (e.g. +91XXXXXXXXXX): ").strip()

    # ======= BUILD MESSAGE =======
    try:
        message = build_message(city)
        print("\nMessage to be sent:\n")
        print(message)
    except Exception as e:
        print("Error building message:", e)
        exit(1)

    # ======= CHOOSE SEND MODE =======
    mode = input("\nSend now (n) or schedule (s)? [n/s]: ").strip().lower()

    if mode == "s":
        # Schedule specific time
        try:
            hour = int(input("Enter send hour (24h format, e.g. 14 for 2 PM): "))
            minute = int(input("Enter send minute (0–59): "))
            print("Scheduling message... Browser will open near that time.")
            send_whatsapp_scheduled(phone, message, hour, minute)
        except Exception as e:
            print("Error scheduling WhatsApp message:", e)

    else:
        # Instant send
        try:
            print("Sending message instantly... Keep your browser and internet ON.")
            send_whatsapp_instant(phone, message)
        except Exception as e:
            print("Error sending WhatsApp message:", e)
